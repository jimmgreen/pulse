#include <windows.h>
101 DIALOGEX 0, 0, 180, 45
STYLE WS_CHILD | DS_CONTROL | DS_SETFONT
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
 EDITTEXT 1001, 5, 4, 160, 14, ES_AUTOHSCROLL | WS_TABSTOP
 PUSHBUTTON "Template button", 1002, 5, 24, 160, 14, WS_TABSTOP
END

102 DIALOGEX 0, 0, 180, 48
STYLE WS_CHILD | DS_CONTROL | DS_SETFONT
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Settings:", -1, 4, 5, 43, 12
 COMBOBOX 1101, 50, 3, 120, 54, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Slices:", -1, 4, 26, 43, 12
 COMBOBOX 1102, 50, 24, 120, 54, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END
