102 ICON "icons/zipx.ico"
103 ICON "icons/7z.ico"
104 ICON "icons/rar.ico"
105 ICON "icons/tar.ico"
106 ICON "icons/gz.ico"
107 ICON "icons/xz.ico"
108 ICON "icons/bz2.ico"
109 ICON "icons/lzma.ico"
110 ICON "icons/z.ico"
111 ICON "icons/cab.ico"
112 ICON "icons/lzh.ico"
113 ICON "icons/lha.ico"
114 ICON "icons/arj.ico"
115 ICON "icons/cpio.ico"

121 ICON "icons/folder/zip.ico"
122 ICON "icons/folder/zipx.ico"
123 ICON "icons/folder/7z.ico"
