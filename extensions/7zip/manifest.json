{
  "apiVersion": 1,
  "id": "pulse.7zip",
  "name": "7-Zip",
  "resources": ["settings.own"],
  "showcase": {
    "version": "1.1.0",
    "summary": {
      "zh": "支持 7z、zip、rar 等数十种压缩格式：智能解压、虚拟浏览、分卷创建与校验。",
      "en": "Smart extract, virtual browsing, archive creation, and checksums across 7z, zip, rar, and more.",
      "tw": "支援 7z、zip、rar 等數十種壓縮格式：智慧解壓、虛擬瀏覽、分卷建立與校驗。"
    },
    "description": {
      "zh": "基于 7-Zip 独立隔离工作进程构建。可在 Pulse 内直接以虚拟目录打开压缩包并按需提取文件，也支持智能单层展开、AES-256 加密压缩、分卷打包及系统文件关联接管。",
      "en": "Powered by an isolated 7-Zip worker process. Browse archives as virtual folders in Pulse with on-demand extraction, smart single-root unpacking, AES-256 creation, split volumes, and Windows archive associations.",
      "tw": "基於 7-Zip 獨立隔離工作行程建置。可在 Pulse 內直接以虛擬目錄開啟壓縮檔並依需求提取檔案，也支援智慧單層展開、AES-256 加密壓縮、分卷打包及系統檔案關聯接管。"
    },
    "category": "archive",
    "publisher": "Pulse",
    "engine": {
      "zh": "7-Zip 隔离引擎",
      "en": "7-Zip isolated engine",
      "tw": "7-Zip 隔離引擎"
    },
    "license": "LGPL-2.1-or-later",
    "homepage": "https://www.7-zip.org/",
    "source": "https://github.com/ip7z/7zip",
    "icon": "box",
    "iconColor": "#527D70",
    "tags": ["7z", "zip", "rar", "tar", "vfs"],
    "highlights": [
      {
        "zh": "独立进程沙箱隔离解码，避免主界面卡顿或崩溃",
        "en": "Process-isolated decoding keeps Pulse fast and resilient",
        "tw": "獨立行程沙箱隔離解碼，避免主介面卡頓或當機"
      },
      {
        "zh": "支持虚拟文件系统浏览压缩包内容与按需提取",
        "en": "Browse archive contents directly via virtual folders",
        "tw": "支援虛擬檔案系統瀏覽壓縮檔內容與依需求提取"
      },
      {
        "zh": "右键菜单智能解压、快速压缩与 Windows 文件关联管理",
        "en": "Smart extract, quick compress, and reversible file associations",
        "tw": "右鍵選單智慧解壓、快速壓縮與 Windows 檔案關聯管理"
      }
    ],
    "quickSettings": {
      "title": {
        "zh": "常用压缩与菜单设置",
        "en": "Archive & menu quick settings",
        "tw": "常用壓縮與選單設定"
      },
      "readyState": "ready",
      "statusState": "status",
      "rows": [
