              "options": [
                { "value": "0", "label": { "zh": "仅存储", "en": "Store", "tw": "僅儲存" } },
                { "value": "1", "label": { "zh": "极速", "en": "Fastest", "tw": "極速" } },
                { "value": "2", "label": { "zh": "快速", "en": "Fast", "tw": "快速" } },
                { "value": "3", "label": { "zh": "标准", "en": "Normal", "tw": "標準" } },
                { "value": "4", "label": { "zh": "最大", "en": "Maximum", "tw": "最大" } },
                { "value": "5", "label": { "zh": "极限", "en": "Ultra", "tw": "極限" } }
              ]
            }
          ]
        },
        {
          "title": {
            "zh": "记住密码",
            "en": "Remember passwords",
            "tw": "記住密碼"
          },
          "description": {
            "zh": "本次会话内自动复用已验证过的压缩包密码",
            "en": "Reuse verified passwords during this session",
            "tw": "本次工作階段自動複用已驗證過的壓縮檔密碼"
          },
          "controls": [
            {
              "kind": "switch",
              "state": "remember"
            }
          ]
        },
        {
          "title": {
            "zh": "折叠到 7-Zip 子菜单",
            "en": "Group in 7-Zip submenu",
            "tw": "摺疊到 7-Zip 子選單"
          },
          "description": {
            "zh": "开启后将全部动作收纳进一级 7-Zip 子菜单中",
            "en": "Place all actions under a single 7-Zip submenu",
            "tw": "開啟後將全部動作收納進一級 7-Zip 子選單中"
          },
          "controls": [
