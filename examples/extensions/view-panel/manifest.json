{
  "apiVersion": 1,
  "id": "example.view-panel",
  "name": "视图切换面板",
  "commands": [
    { "id": "extra-large", "title": "超大图标", "capability": "view.setMode", "args": { "mode": "extra_large_icons" } },
    { "id": "large", "title": "大图标", "capability": "view.setMode", "args": { "mode": "large_icons" } },
    { "id": "medium", "title": "中等图标", "capability": "view.setMode", "args": { "mode": "medium_icons" } },
    { "id": "small", "title": "小图标", "capability": "view.setMode", "args": { "mode": "small_icons" } },
    { "id": "list", "title": "列表", "capability": "view.setMode", "args": { "mode": "list" } },
    { "id": "details", "title": "详细信息", "capability": "view.setMode", "args": { "mode": "details" } },
    { "id": "tiles", "title": "平铺", "capability": "view.setMode", "args": { "mode": "tiles" } },
    { "id": "content", "title": "内容", "capability": "view.setMode", "args": { "mode": "content" } }
  ],
  "panel": {
    "title": "视图切换工具",
    "description": "切换当前文件夹视图；选择会保存为文件夹视图偏好。",
    "commands": ["extra-large", "large", "medium", "small", "list", "details", "tiles", "content"],
    "fields": [
      { "label": "当前视图", "binding": "context.viewMode" },
      { "label": "当前目录", "binding": "context.directory" },
      { "label": "已选数量", "binding": "context.selectionCount" }
    ]
  }
}
