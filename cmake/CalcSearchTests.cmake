# Focused real search-window peer. The source snapshot keeps baseline behavior.
foreach(variant IN ITEMS modified baseline rollback)
    set(target pulse_search_calculation_${variant}_test)
    set(snapshot "${CMAKE_SOURCE_DIR}/bench_data/search-calc-coexist-20261126/original/src/app/global_search_window.cpp")
    if(variant STREQUAL "rollback")
        set(snapshot "${CMAKE_SOURCE_DIR}/bench_data/search-calc-coexist-20261126/rollback-copy/src/app/global_search_window.cpp")
    endif()
    if(NOT variant STREQUAL "modified" AND NOT EXISTS "${snapshot}")
        continue()
    endif()
    add_executable(${target} EXCLUDE_FROM_ALL src/bench/global_search_window_test.cpp
        src/bench/ctrl_search_profile_fixture.cpp
        $<FILTER:$<TARGET_OBJECTS:pulse>,EXCLUDE,global_search_window\\.cpp\\.obj$>)
    target_link_libraries(${target} PRIVATE "$<TARGET_PROPERTY:pulse,LINK_LIBRARIES>")
    foreach(prop INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
        get_target_property(value pulse ${prop})
        if(value)
            set_property(TARGET ${target} PROPERTY ${prop} "${value}")
        endif()
    endforeach()
    target_include_directories(${target} PRIVATE "${CMAKE_SOURCE_DIR}/src/app")
    target_compile_definitions(${target} PRIVATE PULSE_SEARCH_ISOLATED_PROFILE=1)
    if(NOT variant STREQUAL "modified")
        target_compile_definitions(${target} PRIVATE PULSE_SEARCH_WINDOW_SOURCE="${snapshot}")
    endif()
endforeach()
