foreach(variant IN ITEMS baseline modified)
    if(variant STREQUAL "baseline")
        set(baseline "${CMAKE_CURRENT_SOURCE_DIR}/bench_data/animation-closeout-20261125/theme-original/src/ui/FluentTokens.h")
        if(NOT EXISTS "${baseline}")
            continue()
        endif()
    endif()
    add_executable(pulse_animation_theme_${variant} EXCLUDE_FROM_ALL src/bench/animation_theme_color_test.cpp)
    target_include_directories(pulse_animation_theme_${variant} PRIVATE src/ui)
    if(variant STREQUAL "baseline")
        target_compile_definitions(pulse_animation_theme_${variant} PRIVATE PULSE_THEME_BASELINE_HEADER="${baseline}")
    endif()
    target_link_libraries(pulse_animation_theme_${variant} PRIVATE user32 gdi32 dwmapi)
endforeach()
