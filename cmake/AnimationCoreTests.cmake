# Preserved pre-change production objects; test source must use matching old headers.
file(GLOB_RECURSE PULSE_ANIMATION_BASELINE_OBJECTS
    "${CMAKE_SOURCE_DIR}/bench_data/animation-refine-20261124/baseline-objects/CMakeFiles/pulse.dir/*.obj"
    "${CMAKE_SOURCE_DIR}/bench_data/animation-refine-20261124/baseline-objects/CMakeFiles/pulse.dir/*.res")
if(PULSE_ANIMATION_BASELINE_OBJECTS)
    set_source_files_properties(${PULSE_ANIMATION_BASELINE_OBJECTS} PROPERTIES EXTERNAL_OBJECT TRUE)
endif()
function(pulse_animation_baseline target source)
    add_executable(${target} EXCLUDE_FROM_ALL ${source} ${PULSE_ANIMATION_BASELINE_OBJECTS})
    target_link_libraries(${target} PRIVATE "$<TARGET_PROPERTY:pulse,LINK_LIBRARIES>")
    foreach(prop INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
        get_target_property(value pulse ${prop})
        if(value)
            set_property(TARGET ${target} PROPERTY ${prop} "${value}")
        endif()
    endforeach()
endfunction()
if(PULSE_ANIMATION_BASELINE_OBJECTS AND EXISTS "${CMAKE_SOURCE_DIR}/bench_data/animation-refine-20261124/original/src/bench/animation_aux_test.cpp")
    pulse_animation_baseline(pulse_animation_aux_baseline
        bench_data/animation-refine-20261124/original/src/bench/animation_aux_test.cpp)
endif()
if(EXISTS "${CMAKE_SOURCE_DIR}/src/bench/animation_core_test.cpp")
    add_executable(pulse_animation_core_test EXCLUDE_FROM_ALL
        src/bench/animation_core_test.cpp $<TARGET_OBJECTS:pulse>)
    target_link_libraries(pulse_animation_core_test PRIVATE "$<TARGET_PROPERTY:pulse,LINK_LIBRARIES>")
    foreach(prop INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
        get_target_property(value pulse ${prop})
        if(value)
            set_property(TARGET pulse_animation_core_test PROPERTY ${prop} "${value}")
        endif()
    endforeach()
    if(PULSE_ANIMATION_BASELINE_OBJECTS AND EXISTS "${CMAKE_SOURCE_DIR}/bench_data/animation-refine-20261124/original/src/bench/animation_core_test.cpp")
        pulse_animation_baseline(pulse_animation_core_baseline
            bench_data/animation-refine-20261124/original/src/bench/animation_core_test.cpp)
    endif()
endif()


