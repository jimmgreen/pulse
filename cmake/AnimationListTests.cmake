if(TARGET pulse)
    add_executable(pulse_animation_list_test EXCLUDE_FROM_ALL src/bench/animation_list_test.cpp $<TARGET_OBJECTS:pulse>)
    set(animation_original "${CMAKE_SOURCE_DIR}/bench_data/animation-refine-20261124/original")
    set(animation_baseline "${CMAKE_SOURCE_DIR}/bench_data/animation-refine-20261124/baseline-objects")
    file(GLOB_RECURSE animation_baseline_objects "${animation_baseline}/CMakeFiles/pulse.dir/*.obj" "${animation_baseline}/CMakeFiles/pulse.dir/*.res")
    if(animation_baseline_objects AND EXISTS "${animation_original}/src/bench/animation_list_test.cpp")
        add_executable(pulse_animation_list_baseline EXCLUDE_FROM_ALL "${animation_original}/src/bench/animation_list_test.cpp" ${animation_baseline_objects})
    endif()
    foreach(animation_target pulse_animation_list_test pulse_animation_list_baseline)
        if(TARGET ${animation_target})
            target_link_libraries(${animation_target} PRIVATE "$<TARGET_PROPERTY:pulse,LINK_LIBRARIES>")
            foreach(animation_property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
                get_target_property(animation_value pulse ${animation_property})
                if(animation_value)
                    set_property(TARGET ${animation_target} PROPERTY ${animation_property} "${animation_value}")
                endif()
            endforeach()
        endif()
    endforeach()
endif()

