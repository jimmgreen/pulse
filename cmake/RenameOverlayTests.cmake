if(TARGET pulse)
    set(PULSE_RENAME_OVERLAY_EXISTING_OBJECTS "" CACHE PATH "Optional built pulse object directory for isolated renderer verification")
    set(rename_objects $<TARGET_OBJECTS:pulse>)
    if(PULSE_RENAME_OVERLAY_EXISTING_OBJECTS)
        file(GLOB_RECURSE rename_objects "${PULSE_RENAME_OVERLAY_EXISTING_OBJECTS}/*.obj" "${PULSE_RENAME_OVERLAY_EXISTING_OBJECTS}/*.res")
        list(FILTER rename_objects EXCLUDE REGEX "ui_pane_list.cpp.obj$")
        set(rename_current_source src/ui/ui_pane_list.cpp)
        set(rename_resource src/bench/localization_test.rc)
        add_library(pulse_rename_overlay_objects STATIC EXCLUDE_FROM_ALL ${rename_objects})
        set_target_properties(pulse_rename_overlay_objects PROPERTIES LINKER_LANGUAGE CXX)
        set(rename_objects "")
        set(rename_object_library pulse_rename_overlay_objects)
    endif()
    add_executable(pulse_rename_overlay_test EXCLUDE_FROM_ALL
        src/bench/rename_overlay_test.cpp ${rename_resource} ${rename_current_source} ${rename_objects})
    set(rename_baseline "${CMAKE_SOURCE_DIR}/bench_data/rename-group-overlay-20261126/original/src/ui/ui_pane_list.cpp")
    if(EXISTS "${rename_baseline}")
        configure_file("${rename_baseline}" "${CMAKE_CURRENT_BINARY_DIR}/rename-overlay-baseline/ui_pane_list.cpp" COPYONLY)
        add_executable(pulse_rename_overlay_baseline EXCLUDE_FROM_ALL
            src/bench/rename_overlay_test.cpp ${rename_resource} "${CMAKE_CURRENT_BINARY_DIR}/rename-overlay-baseline/ui_pane_list.cpp"
            $<FILTER:${rename_objects},EXCLUDE,ui_pane_list.cpp.obj$>)
        target_include_directories(pulse_rename_overlay_baseline PRIVATE "${CMAKE_SOURCE_DIR}/src/ui")
    endif()
    foreach(target pulse_rename_overlay_test pulse_rename_overlay_baseline)
        if(TARGET ${target})
            get_target_property(rename_libraries pulse LINK_LIBRARIES)
            target_link_libraries(${target} PRIVATE ${rename_object_library} ${rename_libraries})
            target_link_options(${target} PRIVATE /OPT:REF)
            foreach(prop INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
                get_target_property(value pulse ${prop})
                if(value)
                    set_property(TARGET ${target} APPEND PROPERTY ${prop} "${value}")
                endif()
            endforeach()
        endif()
    endforeach()
endif()
