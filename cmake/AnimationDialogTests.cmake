# Search UI lifecycle: preserve old dependencies only for the historical baseline.
file(GLOB_RECURSE animation_search_objects
    "${CMAKE_SOURCE_DIR}/bench_data/animation-refine-20261124/baseline-objects/CMakeFiles/pulse.dir/*.obj")
if(TARGET pulse)
list(FILTER animation_search_objects EXCLUDE REGEX "/global_search_window\\.cpp\\.obj$")
foreach(animation_dialog_variant IN ITEMS baseline modified)
    set(animation_search_source "${CMAKE_SOURCE_DIR}/src/app/global_search_window.cpp")
    if(animation_dialog_variant STREQUAL "baseline")
        if(NOT animation_search_objects)
            continue()
        endif()
        set(animation_search_source "${CMAKE_SOURCE_DIR}/bench_data/animation-refine-20261124/original/src/app/global_search_window.cpp")
    endif()
    if(NOT EXISTS "${animation_search_source}" AND NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${animation_search_source}")
        continue()
    endif()
    set(animation_search_target pulse_animation_search_${animation_dialog_variant})
    set(animation_variant_objects ${animation_search_objects})
    if(animation_dialog_variant STREQUAL "modified")
        # The probe includes the owning search CPP. Every other object/resource
        # comes from this same normal build, never a historical AppState layout.
        add_executable(${animation_search_target} EXCLUDE_FROM_ALL src/bench/animation_search_test.cpp
            $<FILTER:$<TARGET_OBJECTS:pulse>,EXCLUDE,global_search_window\\.cpp\\.obj$>)
    else()
        add_executable(${animation_search_target} EXCLUDE_FROM_ALL src/bench/animation_search_test.cpp src/bench/child_edit_test.rc src/bench/localization_test.rc ${animation_variant_objects})
    endif()
    target_link_libraries(${animation_search_target} PRIVATE "$<TARGET_PROPERTY:pulse,LINK_LIBRARIES>")
    foreach(prop INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS LINK_OPTIONS)
        get_target_property(value pulse ${prop})
        if(value)
            set_property(TARGET ${animation_search_target} PROPERTY ${prop} "${value}")
        endif()
    endforeach()
    target_compile_definitions(${animation_search_target} PRIVATE ANIMATION_SEARCH_SOURCE="${animation_search_source}")
    get_filename_component(animation_search_app_dir "${animation_search_source}" DIRECTORY)
    target_compile_definitions(${animation_search_target} PRIVATE
        ANIMATION_MRU_HEADER="${animation_search_app_dir}/../ui/tab_mru_view.h"
        ANIMATION_WINDOW_SWITCHER_HEADER="${animation_search_app_dir}/../ui/window_switcher_view.h")
endforeach()

endif()
