{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulse extension manifest v1",
  "description": "Native package metadata. The host additionally checks UTF-8 byte limits and the 64 KiB file limit. Unknown and removed declarative fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "name"
  ],
  "properties": {
    "apiVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "$ref": "#/$defs/displayText"
    },
    "resources": {
      "type": "array",
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "enum": [
          "context.read",
          "files.readCurrentDirectory",
          "operations.own",
          "settings.own",
          "audit.own",
          "files.renameCurrentDirectory",
          "files.readDirectory",
          "files.watchDirectory",
          "files.open",
          "context.events",
          "files.transferCurrentSelection",
          "files.deleteCurrentSelection",
          "files.transferToDirectory",
          "files.transferFromDirectory",
          "files.transferDirectoryTree"
        ]
      },
      "description": "Capabilities disclosed at installation; declarations do not gate individual native calls. Instance lifecycle and handle ownership remain enforced."
    },
    "native": {
      "$ref": "#/$defs/nativePackage",
      "description": "Explicit trusted in-process Windows x64 DLL package. Mutually exclusive with runtime. Discovery grants no execution authority."
    },
    "contributes": {
      "$ref": "#/$defs/contributions",
      "description": "Optional static declarations used for zero-load command/shortcut discovery before the native DLL is activated on demand."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "displayText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "At most 128 UTF-8 bytes after JSON decoding. JSON Schema maxLength counts characters, not bytes; the host enforces the byte limit."
    },
    "nativePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "architecture",
        "library",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "architecture": {
          "const": "windows-x64"
        },
        "library": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,123}\\.dll$",
          "maxLength": 128,
          "not": {
            "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])\\."
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 63,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "description": "Additional package files. Flat non-reserved ASCII filenames, no trailing dot or case-insensitive duplicates including the entry DLL. Each file <=64 MiB; whole package <=256 MiB."
        }
      }
    },
    "localizedText": {
      "oneOf": [
        {
          "$ref": "#/$defs/displayText"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zh",
            "en"
          ],
          "properties": {
            "zh": {
              "$ref": "#/$defs/displayText"
            },
            "en": {
              "$ref": "#/$defs/displayText"
            },
            "tw": {
              "$ref": "#/$defs/displayText"
            }
          }
        }
      ]
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icons": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/iconContribution"
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/commandContribution"
          }
        }
      }
    },
    "iconLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "stroke": {
          "type": "boolean"
        },
        "fill": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "pattern": "^(?:inherit|accent|success|warning|danger|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8})$"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 8.0
        },
        "opacity": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1.0
        }
      }
    },
    "iconContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layers"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "viewBox": {
          "type": "number",
          "minimum": 4.0,
          "maximum": 1024.0
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/iconLayer"
          }
        }
      }
    },
    "commandContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kinds",
        "minSelection",
        "maxSelection"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "detail": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 160
            },
            {
              "$ref": "#/$defs/localizedText"
            }
          ]
        },
        "group": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "$ref": "#/$defs/localizedText"
            }
          ]
        },
        "groupIcon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 130
        },
        "submenu": {
          "type": "boolean"
        },
        "primary": {
          "type": "boolean"
        },
        "separatorBefore": {
          "type": "boolean"
        },
        "separatorAfter": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "checked": {
          "type": "boolean"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 130
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "files",
              "directories",
              "background"
            ]
          }
        },
        "minSelection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxSelection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "extensions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^\\.[a-z0-9._-]+$"
          }
        },
        "excludeExtensions": {
          "type": "boolean"
        },
        "shortcut": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^(?:[A-Z0-9]|F(?:[1-9]|1[0-9]|2[0-4]))$"
            },
            "ctrl": {
              "type": "boolean"
            },
            "shift": {
              "type": "boolean"
            },
            "alt": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
